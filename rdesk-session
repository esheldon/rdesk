#!/bin/sh
# rdesk-session: run your remote desktop on this host.  Everything it needs is
# in this bundle: nothing is installed, and no system libraries are used.
#
#   rdesk-session start    start the session if needed; print its socket path
#   rdesk-session status   print the socket path if a session is running
#   rdesk-session stop     end the session
#   rdesk-session log      show what the session and its programs printed
#   rdesk-session version  which bundle this is
#
# The desktop is reached only through a Unix socket that just you can open,
# so no password is needed and nothing listens on the network.
#
#   RDESK_GEOMETRY   initial desktop size (default 1920x1200); your viewer can
#                    resize the desktop once connected

set -eu

# where this bundle lives: any path works, and a symlink to this script is fine
self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
[ -n "$self" ] || self=$0
B=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
GEOMETRY=${RDESK_GEOMETRY:-1920x1200}

STATE=${XDG_RUNTIME_DIR:-/tmp}/rdesk-$(id -u)
SOCK=$STATE/vnc.sock
XAUTH=$STATE/Xauthority
PIDFILE=$STATE/xvnc.pid
LOG=$STATE/session.log

mkdir -p "$STATE" 2>/dev/null || true
if [ "$(ls -ldn "$STATE" | awk '{print $3}')" != "$(id -u)" ]; then
    echo "rdesk: $STATE is not owned by you" >&2
    exit 1
fi
chmod 700 "$STATE"

# Is the pid in the pidfile really this session's Xvnc?  A stale pidfile whose
# number has since been reused must never make us kill somebody else's process,
# so check that the process was started with our own socket path.
session_pid() {
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF -- "$SOCK" || return 1
    echo "$pid"
}

# A session whose state directory has been removed under it (some hosts clear
# the runtime directory at logout) still has its Xvnc running, with no pidfile
# left to find it by.  Look for it among our own processes instead, by the
# socket path it was started with.
orphan_pid() {
    marker="rdesk-$(id -u)/vnc\\.sock"
    for p in /proc/[0-9]*; do
        kill -0 "${p#/proc/}" 2>/dev/null || continue        # ours, and alive
        tr '\0' ' ' < "$p/cmdline" 2>/dev/null |
            grep -q "^Xvnc .*-rfbunixpath [^ ]*$marker" || continue
        echo "${p#/proc/}"
        return 0
    done
    return 1
}

running() {
    [ -S "$SOCK" ] && session_pid > /dev/null
}

# Font setup for the session: the bundle's own fonts plus whatever the host
# has, so programs started from the desktop keep the host's font setup.  The
# file is written with absolute paths, since fontconfig's relative prefixes do
# not work for its cache directory.  Keeping the cache inside the bundle means
# reinstalling the bundle discards it; a cache from an earlier bundle can
# otherwise keep naming fonts that no longer exist.
make_fonts_conf() {
    mkdir -p "$B/cache" 2>/dev/null || true
    # a changed directory time makes fontconfig re-read the fonts, so a cache
    # written for an earlier bundle is never trusted for this one
    touch "$B/share/fonts" 2>/dev/null || true
    # the cache directory comes first: fontconfig writes to the first one it
    # can, and the host's config names its own
    cat > "$STATE/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <cachedir>$B/cache</cachedir>
  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>
  <dir>$B/share/fonts</dir>
  <alias><family>monospace</family><default><family>DejaVu Sans Mono</family></default></alias>
  <alias><family>sans-serif</family><default><family>DejaVu Sans</family></default></alias>
  <alias><family>serif</family><default><family>DejaVu Serif</family></default></alias>
</fontconfig>
EOF
}

# The window manager is started through your login shell, so that it and
# everything you launch from the desktop get the environment a normal login
# gets: the PATH additions from /etc/profile and /etc/profile.d, your own
# profile, locale settings and so on.  Nothing else in the chain that starts
# a session is a login shell, so without this they would all be missing.
#
# jwm uses your own configuration if you have one ($XDG_CONFIG_HOME/jwm/jwmrc,
# ~/.config/jwm/jwmrc or ~/.jwmrc), and otherwise jwm.rdesk from this bundle,
# since its compiled-in fallback is a path on the build machine.  The check
# runs after your profile, which may set XDG_CONFIG_HOME.
make_wm_start() {
    cat > "$STATE/wm-exec" <<EOF
#!/bin/sh
# run by your login shell (see wm-start): jwm, with your own config if you have one
for f in "\${XDG_CONFIG_HOME:-\$HOME/.config}/jwm/jwmrc" "\$HOME/.config/jwm/jwmrc" "\$HOME/.jwmrc"; do
    [ -f "\$f" ] && exec "$B/bin/jwm"
done
exec "$B/bin/jwm" -f "$B/share/jwm/jwm.rdesk"
EOF
    cat > "$STATE/wm-start" <<EOF
#!/bin/sh
# start the window manager as your login shell would: see rdesk-session
cmd='exec sh "$STATE/wm-exec"'
if command -v bash > /dev/null 2>&1; then
    # bash can give any shell a login name (argv[0] beginning with "-"),
    # which is what makes it a login shell; this also works for tcsh, which
    # does not accept -l together with -c
    exec bash -c 'exec -l "\$0" -c "\$1"' "\${SHELL:-/bin/sh}" "\$cmd"
fi
exec "\${SHELL:-/bin/sh}" -l -c "\$cmd"
EOF
}

start() {
    running && { echo "$SOCK"; return 0; }
    rm -f "$SOCK" "$XAUTH" "$STATE/display"
    make_wm_start
    make_fonts_conf

    PATH=$B/bin:$PATH
    export PATH XAUTHORITY=$XAUTH
    cookie=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    # the server accepts every cookie in the file; clients match by display,
    # so the real entry is added below once the display number is known
    xauth -f "$XAUTH" add :0 . "$cookie" >> "$LOG" 2>&1 ||
        { echo "rdesk: could not create the display's access cookie; see $LOG" >&2; exit 1; }

    # Core (bitmap) fonts are served by the X server itself.  Start with the
    # bundle's misc-fixed family, so "fixed" has the same coverage everywhere,
    # then add whatever core font directories this host has, so its own bitmap
    # fonts are available too.
    fontpath=$B/share/xfonts/misc
    for d in /usr/share/fonts/X11/misc /usr/share/fonts/X11/75dpi \
             /usr/share/fonts/X11/100dpi /usr/share/fonts/X11/Type1 \
             /usr/share/X11/fonts/misc /usr/share/X11/fonts/75dpi \
             /usr/share/X11/fonts/100dpi /usr/share/X11/fonts/Type1 \
             /usr/share/fonts/misc /usr/share/fonts/75dpi /usr/share/fonts/100dpi; do
        [ -f "$d/fonts.dir" ] && fontpath="$fontpath,$d"
    done
    fontpath="$fontpath,built-ins"

    : > "$STATE/display"
    # -rfbport -1: no network listener at all; the session is reachable only
    # through the socket above, which only your account can open
    nohup env -u LD_LIBRARY_PATH Xvnc -displayfd 3 -auth "$XAUTH" \
        -rfbunixpath "$SOCK" -rfbunixmode 0600 -rfbport -1 -SecurityTypes None \
        -geometry "$GEOMETRY" -depth 24 -xkbdir "$B/share/X11/xkb" -fp "$fontpath" \
        -desktop "rdesk $(uname -n)" -nolisten tcp \
        < /dev/null >> "$LOG" 2>&1 3> "$STATE/display" &
    echo $! > "$PIDFILE"

    n=0
    while [ ! -s "$STATE/display" ]; do
        n=$((n + 1))
        [ "$n" -gt 100 ] && { echo "rdesk: Xvnc did not start; see $LOG" >&2; exit 1; }
        sleep 0.1 2>/dev/null || sleep 1
    done
    display=:$(cat "$STATE/display")
    xauth -f "$XAUTH" add "$display" . "$cookie" >> "$LOG" 2>&1 ||
        { echo "rdesk: could not register the display's access cookie; see $LOG" >&2; exit 1; }

    # the window manager; when it exits, the session ends
    DISPLAY=$display
    export DISPLAY
    export FONTCONFIG_FILE=$STATE/fonts.conf
    # Xvnc has no DRI3 (or GLX), so OpenGL programs always end up with Mesa's
    # software renderer; saying so up front spares every one of them a failed
    # attempt at hardware rendering and the warning it prints.  Your profile
    # runs later, so it can still unset this.
    export LIBGL_ALWAYS_SOFTWARE=1
    # if the window manager ever exits, shut the display server down with it and
    # clear the socket, so the next connection starts a clean session
    nohup sh -c "sh '$STATE/wm-start' >> '$LOG' 2>&1
                 p=\$(cat '$PIDFILE' 2>/dev/null)
                 if [ -n \"\$p\" ] &&
                    tr '\\0' ' ' < /proc/\$p/cmdline 2>/dev/null | grep -qF -- '$SOCK'
                 then
                     kill \"\$p\" 2>/dev/null
                 fi
                 rm -f '$SOCK' '$PIDFILE'" < /dev/null >> "$LOG" 2>&1 &

    echo "$SOCK"
}

case "${1:-start}" in
    start)  start ;;
    status) running && echo "$SOCK" || { echo "no session"; exit 1; } ;;
    version)
        echo "rdesk bundle 2026-09-15, installed in $B"
        "$B/bin/jwm" -v 2>&1 | grep -m 1 .
        "$B/bin/Xvnc" -version 2>&1 | grep -m 1 .
        ;;
    log)    # log [lines]: what the session and its programs have printed
        [ -f "$LOG" ] && tail -n "${2:-40}" "$LOG" || echo "no log yet at $LOG"
        ;;
    stop)
        if pid=$(session_pid); then
            kill "$pid" 2>/dev/null || true
            rm -f "$SOCK" "$PIDFILE"
            echo "stopped"
        elif pid=$(orphan_pid); then
            kill "$pid" 2>/dev/null || true
            rm -f "$SOCK" "$PIDFILE"
            echo "stopped (a session whose state directory had been removed)"
        else
            rm -f "$SOCK" "$PIDFILE"      # clear anything stale left behind
            echo "no session"
        fi
        ;;
    *) echo "usage: rdesk-session [start|status|stop|log|version]" >&2; exit 2 ;;
esac
