--- a/src/lib/loaders.h
+++ b/src/lib/loaders.h
@@ -26,6 +26,19 @@
     const char     *name;
 };
 
+#ifdef IMLIB2_STATIC_LOADERS
+/* A statically linked program cannot dlopen() the loader modules, so they are
+ * compiled into the library instead, each with its "loader" symbol renamed.
+ * The build supplies this table of them, ending with a NULL name; each is
+ * named as its module file would be, e.g. "png". */
+typedef struct {
+    const char     *name;
+    ImlibLoaderModule *module;
+} ImlibStaticLoader;
+
+extern const ImlibStaticLoader __imlib_static_loaders[];
+#endif
