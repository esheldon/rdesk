 	return p;
 }
 
+/* The path of one of feh's data files: share/feh/NAME next to the directory
+ * the running program is in, so that feh finds its fonts and images wherever
+ * it has been installed.  PREFIX's copy only if the program cannot be found. */
+char *feh_data_path(const char *name)
+{
+	static char *dir = NULL;
+	char exe[PATH_MAX], *slash;
+	ssize_t n;
+
+	if (!dir) {
+		n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+		if (n > 0) {
+			exe[n] = '\0';
+			if ((slash = strrchr(exe, '/')))    /* drop /feh */
+				*slash = '\0';
+			if ((slash = strrchr(exe, '/')))    /* drop /bin */
+				*slash = '\0';
+			dir = estrjoin("", exe, "/share/feh", NULL);
+		} else {
+			dir = estrdup(PREFIX "/share/feh");
+		}
+	}
+	return estrjoin("/", dir, name, NULL);
+}
